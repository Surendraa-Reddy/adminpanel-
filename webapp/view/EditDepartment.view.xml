<mvc:View
    controllerName="employee.controller.EditDepartment"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">

    <Page
        title="Edit Department"
        showNavButton="true"
        navButtonPress="onBack">

        <content>

            <Panel
                headerText="Department Details"
                class="sapUiResponsiveMargin sapUiContentPadding">

                <f:SimpleForm
                    editable="true"
                    layout="ResponsiveGridLayout"
                    columnsXL="2"
                    columnsL="2"
                    columnsM="2"
                    labelSpanXL="4"
                    labelSpanL="4"
                    labelSpanM="4"
                    emptySpanL="2"
                    emptySpanM="2">

                    <Title text="Department Information"/>

                    <Label
                        text="Department ID"
                        required="true"/>

                    <Input
                        id="deptId"
                        value="{department>/DeptId}"
                        editable="false"/>

                    <Label
                        text="Department Name"
                        required="true"/>

                    <Input
                        id="deptName"
                        value="{department>/DeptName}"/>

                    <Label text="Location"/>

                    <Input
                        id="location"
                        value="{department>/Location}"/>

                    <Label text="Status"/>

                    <Select
                        id="status"
                        selectedKey="{department>/Status}">

                        <items>

                            <core:Item
                                key="1"
                                text="Active"/>

                            <core:Item
                                key="0"
                                text="Inactive"/>

                        </items>

                    </Select>

                </f:SimpleForm>

            </Panel>

        </content>

        <footer>

            <OverflowToolbar>

                <ToolbarSpacer/>

                <Button
                    text="Cancel"
                    type="Transparent"
                    icon="sap-icon://decline"
                    press="onBack"/>

                <Button
                    text="Update"
                    type="Emphasized"
                    icon="sap-icon://save"
                    press="onUpdate"/>

            </OverflowToolbar>

        </footer>

    </Page>

</mvc:View>