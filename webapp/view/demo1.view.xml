  <Panel id="panel1" width="auto" class="sapUiResponsiveMargin">
    <headerToolbar>
        <Toolbar>
            <Title text="Account Login" level="H2"/>
        </Toolbar>
    </headerToolbar>
    <content>
        <VBox id="box2" alignItems="Center" justifyContent="Center" class="sapUiMediumMarginTopBottom">
            
            <f:SimpleForm id="loginForm"
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="3" labelSpanL="3" labelSpanM="4" labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="4" emptySpanL="4" emptySpanM="3" emptySpanS="0"
                columnsXL="1" columnsL="1" columnsM="1"
                singleContainerFullSize="false"
                width="100%"
                maxContainerCols="1">
                <f:content>
                    
                    <Label text="EmployeeName" required="true"/>
                    <Input id="nameInput" placeholder="Enter your Employee Name"/>
                    
                    <Label text="Department" required="true"/>
                    <Input id="deptInput" placeholder="Enter your Department"/>
                    </f:content>
            </f:SimpleForm>
            <HBox >
            <Button id="loginBtn" width="50px" text="save" press="onSaveClick"></Button>
            <Button id="clearBtn" width="50px" text="Clear" press="onClearClick"></Button>
            </HBox>
        </VBox>
    </content>
  </Panel>
  </Page>


</mvc:View>