<mvc:View
    controllerName="employee.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt">

    <tnt:ToolPage
        id="toolPage"
        sideExpanded="true">

        <!-- Header -->
        <tnt:header>

        <OverflowToolbar>

    <Button
        icon="sap-icon://menu2"
        type="Transparent"
        press="onToggleMenu"/>

    <Title text="Employee Management System"/>

    <ToolbarSpacer/>

    <Button
        icon="sap-icon://bell"
        type="Transparent"/>

    <Avatar
        displayShape="Circle"
      initials="{= ${session>/username} ? ${session>/username}.substring(0,1).toUpperCase() : 'A'}"/>

    <Text
        text="{session>/username}"
        class="sapUiTinyMarginEnd"/>

    <Button
        text="Logout"
        icon="sap-icon://log"
        type="Transparent"
        press="onLogout"/>

</OverflowToolbar>

        </tnt:header>

        <!-- Sidebar -->
        <tnt:sideContent>

            <tnt:SideNavigation>

                <tnt:NavigationList>

                    <tnt:NavigationListItem
                        text="Dashboard"
                        icon="sap-icon://home"
                        select="onDashboard"
                        visible="true"/>

                    <tnt:NavigationListItem
                        text="Employees"
                        icon="sap-icon://employee"
                        select="onEmployee"
                        visible="{=
                            ${session>/role} === 'ADMIN'
                            || ${session>/role} === 'HR'
                        }"/>

                    <tnt:NavigationListItem
                        text="Departments"
                        icon="sap-icon://building"
                        select="onDepartment"
                        visible="{=
                        ${session>/role} === 'ADMIN'
                          }"/>

                    <tnt:NavigationListItem
                        text="Roles"
                        icon="sap-icon://manager"
                        select="onRole"
                         visible="{=
                          ${session>/role} === 'ADMIN'
                            }"/>

                    <tnt:NavigationListItem
                        text="Attendance"
                        icon="sap-icon://calendar"
                        select="onAttendance"
                        visible="{=
                             ${session>/role} === 'ADMIN'
                              || ${session>/role} === 'HR'
                             || ${session>/role} === 'MANAGER'
                         }"/>

                    <tnt:NavigationListItem
                        text="Leaves"
                        icon="sap-icon://leave-request"
                        select="onLeave"
                        visible="true"/>

                    <tnt:NavigationListItem
                        text="Reports"
                        icon="sap-icon://business-objects-experience"
                        select="onReports"
                        visible="{=
                               ${session>/role} === 'ADMIN'
                               || ${session>/role} === 'MANAGER'
                           }"/>
                           <tnt:NavigationListItem
                                text="Users"
                                icon="sap-icon://group"
                                visible="{= ${session>/role} === 'ADMIN' }"
                                select="onUsers"/>
                                 <tnt:NavigationListItem
                                      text="Logout"
                                      icon="sap-icon://log"
                                      select="onLogout"/>
                          

                </tnt:NavigationList>

            </tnt:SideNavigation>

        </tnt:sideContent>

        <!-- Main Content -->
        <tnt:mainContents>

            <App id="app"/>

        </tnt:mainContents>

    </tnt:ToolPage>

</mvc:View>