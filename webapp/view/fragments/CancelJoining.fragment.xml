<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="cancelJoiningDialog"
        title="Cancel Joining"
        contentWidth="500px"
        stretchOnPhone="true"
        draggable="true"
        resizable="true"
    >
        <content>
            <VBox class="sapUiMediumMargin">
                <MessageStrip
                    text="Cancellation will permanently change this joining confirmation to CANCELLED."
                    type="Warning"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"
                />

                <Label
                    text="Joining ID"
                    class="sapUiTinyMarginBottom"
                />

                <Input
                    value="{cancelJoining>/JoiningId}"
                    editable="false"
                    class="sapUiSmallMarginBottom"
                />

                <Label
                    text="Candidate"
                    class="sapUiTinyMarginBottom"
                />

                <Input
                    value="{cancelJoining>/CandidateName}"
                    editable="false"
                    class="sapUiSmallMarginBottom"
                />

                <Label
                    text="Current Status"
                    class="sapUiTinyMarginBottom"
                />

                <ObjectStatus
                    text="{cancelJoining>/CurrentStatus}"
                    state="Warning"
                    class="sapUiSmallMarginBottom"
                />

                <Label
                    text="Cancellation Reason"
                    required="true"
                    class="sapUiTinyMarginBottom"
                />

                <TextArea
                    value="{cancelJoining>/Comments}"
                    rows="5"
                    maxLength="255"
                    width="100%"
                    placeholder="Enter the reason for cancellation..."
                />
            </VBox>
        </content>

        <beginButton>
            <Button
                text="Cancel Joining"
                type="Reject"
                icon="sap-icon://decline"
                press=".onSaveCancelJoining"
            />
        </beginButton>

        <endButton>
            <Button
                text="Close"
                type="Transparent"
                press=".onCloseCancelJoining"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
