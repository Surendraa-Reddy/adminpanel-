<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="FeedbackDetailsDialog"
        title="Interview Feedback"
        contentWidth="950px"
        contentHeight="700px"
        draggable="true"
        resizable="true"
    >
        <content>
            <VBox class="sapUiMediumMargin">
                <!-- ================= Header ================= -->

                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                    class="sapUiSmallMarginBottom"
                >
                    <HBox alignItems="Center">
                        <Avatar
                            displayShape="Circle"
                            displaySize="L"
                            icon="sap-icon://employee"
                        />

                        <VBox class="sapUiSmallMarginBegin">
                            <Title
                                text="{details>/CandidateName}"
                                level="H2"
                            />

                            <Text
                                text="Candidate ID : {details>/CandidateId}"
                            />

                            <Text text="Interview : {details>/InterviewId}" />
                        </VBox>
                    </HBox>

                    <ObjectStatus
                        text="{details>/Recommendation}"
                        icon="sap-icon://quality-issue"
                        state="{
                            = ${details>/Recommendation} === 'SELECTED' ? 'Success' :
                              ${details>/Recommendation} === 'REJECTED' ? 'Error' :
                              ${details>/Recommendation} === 'HOLD' ? 'Warning' :
                              'Information'
                        }"
                    />
                </HBox>

                <!-- ================= General ================= -->

                <Panel
                    headerText="General Information"
                    expandable="false"
                    class="sapUiResponsiveMargin"
                >
                    <HBox
                        justifyContent="SpaceAround"
                        class="sapUiMediumMargin"
                    >
                        <VBox>
                            <ObjectIdentifier
                                title="{details>/FeedbackId}"
                                text="Feedback ID"
                            />
                        </VBox>

                        <VBox>
                            <ObjectIdentifier
                                title="{details>/EmpId}"
                                text="Employee ID"
                            />
                        </VBox>

                        <VBox>
                            <ObjectIdentifier
                                title="{details>/InterviewId}"
                                text="Interview ID"
                            />
                        </VBox>

                        <VBox>
                            <Label text="Created On" />

                            <Text
                                text="{
                                      path:'details>/CreatedOn',
                                                                type:'sap.ui.model.type.Date',
                                      formatOptions:{
                                          pattern:'dd-MM-yyyy'
                                         }
                                  }"
                            />
                        </VBox>
                    </HBox>
                </Panel>

                <!-- ================= Ratings ================= -->

                <Panel
                    headerText="Interview Ratings"
                    expandable="false"
                    class="sapUiResponsiveMargin"
                >
                    <VBox class="sapUiMediumMargin">
                        <HBox justifyContent="SpaceBetween">
                            <VBox width="48%">
                                <Label text="Technical Skills" />

                                <RatingIndicator
                                    value="{details>/TechnicalRating}"
                                    maxValue="5"
                                    editable="false"
                                />
                            </VBox>

                            <VBox width="48%">
                                <Label text="Communication" />

                                <RatingIndicator
                                    value="{details>/CommunicationRating}"
                                    maxValue="5"
                                    editable="false"
                                />
                            </VBox>
                        </HBox>

                        <HBox
                            justifyContent="SpaceBetween"
                            class="sapUiMediumMarginTop"
                        >
                            <VBox width="48%">
                                <Label text="Problem Solving" />

                                <RatingIndicator
                                    value="{details>/ProblemSolvingRating}"
                                    maxValue="5"
                                    editable="false"
                                />
                            </VBox>

                            <VBox width="48%">
                                <Label text="Overall Rating" />

                                <RatingIndicator
                                    value="{details>/OverallRating}"
                                    maxValue="5"
                                    editable="false"
                                />
                            </VBox>
                        </HBox>
                    </VBox>
                </Panel>

                <!-- ================= Assessment ================= -->

                <Panel
                    headerText="Candidate Assessment"
                    expandable="false"
                    class="sapUiResponsiveMargin"
                >
                    <VBox class="sapUiMediumMargin">
                        <Label
                            text="Strengths"
                            design="Bold"
                        />

                        <Text
                            text="{details>/Strengths}"
                            wrapping="true"
                        />

                        <Toolbar design="Transparent" />

                        <Label
                            text="Weaknesses"
                            design="Bold"
                        />

                        <Text
                            text="{details>/Weaknesses}"
                            wrapping="true"
                        />
                    </VBox>
                </Panel>

                <!-- ================= Comments ================= -->

                <Panel
                    headerText="Interviewer Comments"
                    expandable="false"
                    class="sapUiResponsiveMargin"
                >
                    <VBox class="sapUiMediumMargin">
                        <Text
                            text="{details>/Comments}"
                            wrapping="true"
                        />
                    </VBox>
                </Panel>
            </VBox>
        </content>

        <!-- <beginButton>
            <Button
                text="Print"
                icon="sap-icon://print"
                type="Transparent"
                press="onPrintFeedback"
            />
        </beginButton> -->

        <endButton>
            <Button
                text="Close"
                icon="sap-icon://decline"
                type="Emphasized"
                press="onCloseFeedbackDetails"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
