<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified">

    <Dialog
        id="uploadPhotoDialog"
        title="Upload Employee Photo"
        contentWidth="450px"
        draggable="true"
        resizable="true">

        <VBox class="sapUiMediumMargin">

            <Avatar
                id="previewAvatar"
                displayShape="Circle"
                displaySize="XL"
                class="sapUiSmallMarginBottom"/>

            <u:FileUploader
                id="fileUploader"
                width="100%"
                fileType="jpg,jpeg,png"
                sameFilenameAllowed="true"
                change="onFileSelected"/>

        </VBox>

        <beginButton>

            <Button
                text="Upload"
                icon="sap-icon://upload"
                type="Emphasized"
                press="onUploadPhoto"/>

        </beginButton>

        <endButton>

            <Button
                text="Cancel"
                press="onCancelUpload"/>

        </endButton>

    </Dialog>

</core:FragmentDefinition>