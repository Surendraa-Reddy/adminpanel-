<mvc:View
controllerName="admindemo.controller.CustomerDetails"
xmlns:mvc="sap.ui.core.mvc"
xmlns="sap.m"
xmlns:f="sap.ui.layout.form">

<Page
title="Customer Details"
showNavButton="true"
navButtonPress="onNavBack">

<content>

<ObjectHeader

title="{CompanyName}"

intro="{CustomerID}"

icon="sap-icon://customer"/>

<f:SimpleForm

editable="false"

layout="ResponsiveGridLayout"

class="sapUiLargeMargin">

<f:content>

<Label text="Contact"/>

<Text text="{ContactName}"/>

<Label text="Designation"/>

<Text text="{ContactTitle}"/>

<Label text="Phone"/>

<Link text="{Phone}"/>

<Label text="City"/>

<Text text="{City}"/>

<Label text="Country"/>

<ObjectStatus
text="{Country}"
state="Success"/>

<Label text="Address"/>

<Text text="{Address}"/>

</f:content>

</f:SimpleForm>

<Toolbar>

<ToolbarSpacer/>

<Button
text="Orders"
icon="sap-icon://sales-order"/>

<Button
text="Edit"
icon="sap-icon://edit"/>

</Toolbar>

</content>

</Page>

</mvc:View>