<mvc:View
    controllerName="admindemo.controller.Orders"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page
        title="Orders Management"
        showNavButton="true"
        navButtonPress="onNavBack">

        <content>

            <VBox class="sapUiMediumMargin">

                <Table
                    id="ordersTable"
                    items="{/Orders}"
                    mode="SingleSelectMaster"
                    selectionChange="onSelectionChange"
                    growing="true"
                    growingThreshold="20">

                    <headerToolbar>

                        <OverflowToolbar>

                            <Title
                                text="Orders"
                                level="H2"/>

                            <ToolbarSpacer/>

                            <SearchField
                                width="220px"
                                placeholder="Search Customer"
                                liveChange="onSearch"/>

                            <DateRangeSelection
                                width="220px"
                                change="onDateFilter"/>

                            <Button
                                icon="sap-icon://refresh"
                                tooltip="Refresh"
                                press="onRefresh"/>

                            <Button
                                icon="sap-icon://sort"
                                tooltip="Sort"
                                press="onSort"/>

                            <Button
                                icon="sap-icon://filter"
                                tooltip="Filter"
                                press="onFilter"/>

                        </OverflowToolbar>

                    </headerToolbar>

                    <columns>

                        <Column width="7rem">
                            <Text text="Order"/>
                        </Column>

                        <Column width="8rem">
                            <Text text="Customer"/>
                        </Column>

                        <Column width="8rem">
                            <Text text="Employee"/>
                        </Column>

                        <Column width="10rem">
                            <Text text="Order Date"/>
                        </Column>

                        <Column width="8rem">
                            <Text text="Freight"/>
                        </Column>

                        <Column width="10rem">
                            <Text text="Status"/>
                        </Column>

                    </columns>

                    <items>

                        <ColumnListItem
                            type="Navigation"
                            highlight="Information">

                            <cells>

                                <ObjectIdentifier
                                    title="{OrderID}"
                                    text="Order"/>

                                <Text
                                    text="{CustomerID}"/>

                                <Text
                                    text="{EmployeeID}"/>

                                <Text
                                    text="{
                                        path:'OrderDate',
                                        type:'sap.ui.model.type.Date',
                                        formatOptions:{
                                            style:'medium'
                                        }
                                    }"/>

                                <ObjectNumber
                                    number="{Freight}"
                                    unit="USD"/>

                                <ObjectStatus
                                    text="{
                                        path:'ShippedDate',
                                        formatter:'.formatter.getStatusText'
                                    }"
                                    state="{
                                        path:'ShippedDate',
                                        formatter:'.formatter.getStatusState'
                                    }"
                                    icon="{
                                        path:'ShippedDate',
                                        formatter:'.formatter.getStatusIcon'
                                    }"/>

                            </cells>

                        </ColumnListItem>

                    </items>

                </Table>

            </VBox>

        </content>

    </Page>

</mvc:View>