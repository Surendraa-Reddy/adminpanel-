<mvc:View
controllerName="admindemo.controller.OrderDetails"
xmlns:mvc="sap.ui.core.mvc"
xmlns="sap.m"
xmlns:f="sap.ui.layout.form">

<Page
title="Order Details"
showNavButton="true"
navButtonPress="onNavBack">

<content>

<ObjectHeader
title="Order #{OrderID}"
number="{Freight}"/>

<f:SimpleForm
editable="false"
layout="ResponsiveGridLayout">

<f:content>

<Label text="Customer"/>
<ObjectIdentifier
    title="{CustomerID}"
    text="Customer"/>

<Label text="Employee"/>
<Text text="{EmployeeID}"/>

<Label text="Ship Name"/>
<Text text="{ShipName}"/>

<Label text="Ship Country"/>
<Text text="{ShipCountry}"/>

<Label text="Order Date"/>
<Text
text="{
path:'OrderDate',
type:'sap.ui.model.type.Date',
formatOptions:{
style:'full'
}
}"/>

<Label text="Required Date"/>
<Text
text="{
path:'RequiredDate',
type:'sap.ui.model.type.Date',
formatOptions:{
style:'medium'
}
}"/>

<Label text="Freight"/>
<ObjectNumber
    number="{
        path:'Freight',
        type:'sap.ui.model.type.Currency',
        formatOptions:{
            showMeasure:false
        }
    }"
    unit="$"
    emphasized="true"
    state="Success"/>

</f:content>

</f:SimpleForm>

</content>

</Page>

</mvc:View>