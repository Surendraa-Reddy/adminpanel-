<mvc:View
    controllerName="employee.controller.Login"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        showHeader="false"
        enableScrolling="false"
        class="sapUiContentPadding">

        <content>

            <FlexBox
                justifyContent="Center"
                alignItems="Center"
                width="100%"
                height="100%">

                <VBox
                    width="430px"
                    class="sapUiResponsiveMargin sapUiMediumMargin">

                    <Panel
                        width="100%"
                        class="sapUiResponsiveMargin">

                        <content>

                            <VBox
                                alignItems="Center"
                                class="sapUiLargeMargin">

                                <!-- Logo -->

                                <Avatar
                                    displayShape="Circle"
                                    displaySize="XL"
                                    backgroundColor="Accent6"
                                    icon="sap-icon://employee-pane"/>

                                <Title
                                    text="HR Management System"
                                    level="H2"
                                    class="sapUiMediumMarginTop"/>

                                <Text
                                    text="Welcome Back"
                                    class="sapUiTinyMarginTop"/>

                                <Text
                                    text="Sign in to continue"
                                    class="sapUiSmallMarginBottom"/>

                            </VBox>

                            <VBox class="sapUiMediumMargin">

                                <Label
                                    text="Username"
                                    required="true"/>

                                <Input
                                    id="idUsername"
                                    placeholder="Enter Username"
                                    submit="onSubmit"
                                    liveChange="onLiveChange">

                                    <layoutData>
                                        <FlexItemData growFactor="1"/>
                                    </layoutData>
                                </Input>

                                <Label
                                    text="Password"
                                    required="true"
                                    class="sapUiMediumMarginTop"/>

                                <Input
                                    id="idPassword"
                                    type="Password"
                                    placeholder="Enter Password"
                                    submit="onSubmit"
                                    liveChange="onLiveChange"/>

                                <HBox
                                    justifyContent="End"
                                    class="sapUiTinyMarginTop">

                                    <Link
                                        text="Forgot Password?"
                                        enabled="false"/>

                                </HBox>

                                <Button
                                    text="Sign In"
                                    icon="sap-icon://log"
                                    type="Emphasized"
                                    width="100%"
                                    class="sapUiLargeMarginTop"
                                    press="onLogin"/>

                            </VBox>

                        </content>

                    </Panel>

                    <VBox
                        alignItems="Center"
                        class="sapUiSmallMarginTop">

                        <Text
                            text="HR Management System"/>

                        <Text
                            text="Version 1.0"/>

                    </VBox>

                </VBox>

            </FlexBox>

        </content>

    </Page>

</mvc:View>