<mvc:View
    controllerName="employee.controller.recruitment.JobOpenings"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    
>
    <Page
        id="jobOpeningPage"
        title="Recruitment - Job Openings"
        showNavButton="true"
        navButtonPress="onNavBack"
    >
        <content>
            <VBox class="sapUiSmallMargin">
                <!-- Header Toolbar -->

                <OverflowToolbar>
                    <Title
                        text="Job Openings"
                        level="H2"
                    />

                    <ToolbarSpacer />

                    <Button
                        text="Create Job"
                        icon="sap-icon://add"
                        type="Emphasized"
                        press="onCreateJob"
                    />
                </OverflowToolbar>

                <!-- Search & Filters -->

                <OverflowToolbar class="sapUiSmallMarginTop">
                    <SearchField
                        id="searchField"
                        width="30%"
                        placeholder="Search by Job Title or Location"
                        search="onSearch"
                        liveChange="onSearch"
                    />

                    <ToolbarSpacer />

                    <Label
                        text="Department"
                        class="sapUiTinyMarginBegin sapUiTinyMarginEnd"
                    />

                    <Select
                        id="departmentFilter"
                        width="180px"
                        change="onFilter"
                    >
                        <core:Item
                            key=""
                            text="All Departments"
                        />
                        <core:Item
                            key="IT"
                            text="IT"
                        />
                        <core:Item
                            key="HR"
                            text="HR"
                        />
                        <core:Item
                            key="Functional"
                            text="Functional"
                        />
                         <core:Item
                                key="Finance"
                                text="Finance"
                            />
                        <core:Item
                            key="Admin"
                            text="Admin"
                        />
                    </Select>

                    <Label
                        text="Status"
                        class="sapUiTinyMarginBegin sapUiTinyMarginEnd"
                    />

                    <Select
                        id="statusFilter"
                        width="150px"
                        change="onFilter"
                    >
                        <core:Item
                            key=""
                            text="All Status"
                        />
                        <core:Item
                            key="OPEN"
                            text="Open"
                        />
                        <core:Item
                            key="CLOSED"
                            text="Closed"
                        />
                    </Select>

                    <ToolbarSeparator />

                    <Button
                        text="Refresh"
                        icon="sap-icon://refresh"
                        type="Transparent"
                        press="onRefresh"
                    />
                </OverflowToolbar>

                <!-- Table -->

                <Table
                    id="jobTable"
                    inset="false"
                    growing="true"
                    growingThreshold="15"
                    growingScrollToLoad="true"
                    sticky="ColumnHeaders,HeaderToolbar"
                    alternateRowColors="true"
                    noDataText="No Job Openings Found"
                    items="{/JobOpeningSet}"
                >
                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="Job List" />

                            <ToolbarSpacer />

                            <Text
                                text="{= ${/JobOpeningSet}.length + ' Jobs'}"
                            />
                        </OverflowToolbar>
                    </headerToolbar>

                    <columns>
                        <Column width="7rem">
                            <Text text="Job ID" />
                        </Column>

                        <Column minScreenWidth="Tablet">
                            <Text text="Job Title" />
                        </Column>

                        <Column width="9rem">
                            <Text text="Department" />
                        </Column>

                        <Column width="10rem">
                            <Text text="Location" />
                        </Column>

                        <Column width="8rem">
                            <Text text="Experience" />
                        </Column>

                        <Column
                            hAlign="Center"
                            width="6rem"
                        >
                            <Text text="Vacancies" />
                        </Column>

                        <Column width="8rem">
                            <Text text="Status" />
                        </Column>

                        <Column
                            hAlign="Center"
                            width="9rem"
                        >
                            <Text text="Actions" />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem type="Inactive">
                            <cells>
                                <ObjectIdentifier title="{JobId}" />

                                <ObjectIdentifier title="{JobTitle}" />

                                <Text text="{Department}" />

                                <Text text="{Location}" />

                                <Text text="{Experience}" />

                                <ObjectNumber number="{Vacancies}" />

                                <ObjectStatus
                                    text="{Status}"
                                    state="{= ${Status} === 'OPEN' ? 'Success' : 'Error' }"
                                />

                                <OverflowToolbar>
                                    <Button
                                        icon="sap-icon://display"
                                        type="Transparent"
                                        press="onViewJob"
                                    />
                                    <Button
                                        icon="sap-icon://edit"
                                        type="Transparent"
                                        tooltip="Edit"
                                        press="onEditJob"
                                    />

                                    <Button
                                        icon="sap-icon://delete"
                                        type="Transparent"
                                        tooltip="Delete"
                                        press="onDeleteJob"
                                    />
                                </OverflowToolbar>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>
