<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <ResponsivePopover
        id="notificationPopover"
        contentWidth="420px"
        placement="Bottom"
        class="sapUiResponsivePadding">

        <!-- Header -->
        <customHeader>
            <Bar>

                <contentLeft>
                    <Title
                        text="🔔 Notifications"
                        level="H3"/>
                </contentLeft>

                <contentRight>
                    <Button
                        icon="sap-icon://accept"
                        text="Mark All Read"
                        type="Transparent"
                        press="onMarkAllRead"/>
                </contentRight>

            </Bar>
        </customHeader>

        <!-- Search + Filter -->
        <VBox class="sapUiSmallMargin">

            <SearchField
                width="100%"
                placeholder="🔍 Search notifications..."
                liveChange="onNotificationSearch"/>

            <SegmentedButton
                width="100%"
                selectedKey="ALL"
                selectionChange="onNotificationFilter"
                class="sapUiSmallMarginTop">

                <items>

                    <SegmentedButtonItem
                        key="ALL"
                        text="All"/>

                    <SegmentedButtonItem
                        key="UNREAD"
                        text="Unread"/>

                    <SegmentedButtonItem
                        key="PAYROLL"
                        text="Payroll"/>

                    <SegmentedButtonItem
                        key="LEAVE"
                        text="Leave"/>

                    <SegmentedButtonItem
                        key="HOLIDAY"
                        text="Holiday"/>

                    <SegmentedButtonItem
                        key="BIRTHDAY"
                        text="Birthday"/>

                </items>

            </SegmentedButton>

        </VBox>

        <!-- Notification Groups -->
        <List
            items="{notification>/NotificationGroups}"
            showSeparators="None"
            noDataText="No notifications found">

            <CustomListItem>

                <VBox width="100%">

                    <!-- Group Heading -->
                    <Title
                        text="{notification>Title}"
                        level="H4"
                        class="sapUiSmallMarginTop sapUiTinyMarginBottom"/>

                    <!-- Notifications -->
                    <List
                        items="{
                            path:'notification>Items',
                            templateShareable:false
                        }"
                        mode="SingleSelectMaster"
                        itemPress="onNotificationSelect">

                        <CustomListItem type="Active">

                            <HBox
                                width="100%"
                                alignItems="Center"
                                class="sapUiSmallMargin">

                                <!-- Notification Icon -->
                                <Avatar
                                    displayShape="Circle"
                                    displaySize="S"
                                    src="{
                                        path:'notification>Type',
                                        formatter:'.formatter.getNotificationIcon'
                                    }"
                                    backgroundColor="{
                                        path:'notification>Type',
                                        formatter:'.formatter.getAvatarColor'
                                    }"/>

                                <!-- Notification Text -->
                                <VBox
                                    width="250px"
                                    class="sapUiTinyMarginBegin">

                                    <Title
                                        text="{notification>Title}"
                                        level="H5"
                                        wrapping="true"/>

                                    <Text
                                        text="{notification>Message}"
                                        wrapping="true"/>

                                    <ObjectStatus
                                        text="{
                                            path:'notification>CreatedOn',
                                            formatter:'.formatter.getRelativeTime'
                                        }"
                                        state="{
                                            path:'notification>MsgType',
                                            formatter:'.formatter.getStatusState'
                                        }"/>

                                </VBox>

                                <ToolbarSpacer/>

                                <!-- Right Side -->
                                <HBox alignItems="Center">

                                    <!-- Unread Indicator -->
                                    <core:Icon
                                        src="sap-icon://notification-2"
                                        color="red"
                                        size="1rem"
                                        visible="{= ${notification>Status} === 'U'}"
                                        class="sapUiTinyMarginEnd"/>

                                    <!-- Delete -->
                                    <Button
                                        icon="sap-icon://delete"
                                        type="Transparent"
                                        tooltip="Delete Notification"
                                        press="onDeleteNotification"/>

                                </HBox>

                            </HBox>

                        </CustomListItem>

                    </List>

                </VBox>

            </CustomListItem>

        </List>

    </ResponsivePopover>

</core:FragmentDefinition>