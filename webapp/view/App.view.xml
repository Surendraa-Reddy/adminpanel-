<mvc:View
    controllerName="employee.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt"
>
    <tnt:ToolPage
        id="toolPage"
        sideExpanded="true"
    >
        <!-- Header -->
        <tnt:header>
            <OverflowToolbar>
                <Button
                    icon="sap-icon://menu2"
                    type="Transparent"
                    press="onToggleMenu"
                />

                <Title text="Employee Management System" />

                <ToolbarSpacer />

                <Button
                    id="notificationButton"
                    icon="sap-icon://bell"
                    text="{notification>/UnreadCount}"
                    type="Transparent"
                    press="onNotificationPress"
                />

                <Avatar
                    displayShape="Circle"
                    initials="{= ${session>/username} ? ${session>/username}.substring(0,1).toUpperCase() : 'A'}"
                />

                <Text
                    text="{session>/username}"
                    class="sapUiTinyMarginEnd"
                />

                <Button
                    text="Logout"
                    icon="sap-icon://log"
                    type="Transparent"
                    press="onLogout"
                />
            </OverflowToolbar>
        </tnt:header>

        <!-- Sidebar -->
        <tnt:sideContent>
            <tnt:SideNavigation>
                <tnt:NavigationList>
                    <tnt:NavigationListItem
                        text="Dashboard"
                        icon="sap-icon://home"
                        select="onDashboard"
                        visible="true"
                    />

                    <tnt:NavigationListItem
                        text="Employees"
                        icon="sap-icon://employee"
                        select="onEmployee"
                        visible="{=
                            ${session>/role} === 'ADMIN'
                            || ${session>/role} === 'HR'
                            || ${session>/role} === 'EMPLOYEE'
                        }"
                    />

                    <tnt:NavigationListItem
                        text="Departments"
                        icon="sap-icon://building"
                        select="onDepartment"
                        visible="{=
                        ${session>/role} === 'ADMIN'
                          }"
                    />

                    <tnt:NavigationListItem
                        text="Roles"
                        icon="sap-icon://manager"
                        select="onRole"
                        visible="{=
                          ${session>/role} === 'ADMIN'
                            }"
                    />

                    <tnt:NavigationListItem
                        text="Attendance"
                        icon="sap-icon://calendar"
                        select="onAttendance"
                        visible="{=
                             ${session>/role} === 'ADMIN'
                              || ${session>/role} === 'HR'
                             || ${session>/role} === 'MANAGER'
                         }"
                    />

                    <tnt:NavigationListItem
                        text="Leaves"
                        icon="sap-icon://leave-request"
                        select="onLeave"
                        visible="true"
                    />
                    <tnt:NavigationListItem
                        text="My Profile"
                        icon="sap-icon://person-placeholder"
                        select="onProfile"
                    />

                    <tnt:NavigationListItem
                        text="Employee Self Service"
                        icon="sap-icon://employee"
                    >
                        <tnt:NavigationListItem
                            text="My Attendance"
                            icon="sap-icon://activity-individual"
                            select="onMyAttendance"
                        />
                        <tnt:NavigationListItem
                            text="Apply Leave"
                            icon="sap-icon://add-activity"
                            press="onApplyLeave"
                        />
                        <tnt:NavigationListItem
                            text="Leave Balance"
                            icon="sap-icon://leave-request"
                            key="LeaveBalance"
                            select=".onLeaveBalance"
                        />
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem
                        text="Reports"
                        icon="sap-icon://business-objects-experience"
                        select="onReports"
                        visible="{=
                               ${session>/role} === 'ADMIN'
                               || ${session>/role} === 'MANAGER'
                           }"
                    />
                    <tnt:NavigationListItem
                        text="Users"
                        icon="sap-icon://group"
                        visible="{= ${session>/role} === 'ADMIN' }"
                        select="onUsers"
                    />
                    <tnt:NavigationListItem
                        text="JobOpenings"
                        icon="sap-icon://person-placeholder"
                        key="jobopen"
                        visible="{= ${session>/role} === 'ADMIN' || ${session>/role} === 'HR' }"
                        select=".onjobopen"
                    />
                    <tnt:NavigationListItem
                        text="Candidate Dashboard"
                        icon="sap-icon://business-objects-experience"
                        visible="{= ${session>/role} === 'ADMIN' || ${session>/role} === 'HR' }"
                        select=".onCandidateDashboard"
                    />
                    <tnt:NavigationListItem
                        text="Payroll"
                        icon="sap-icon://money-bills"
                        key="Payroll"
                        visible="{= ${session>/role} === 'ADMIN' || ${session>/role} === 'HR' }"
                        select=".onPayroll"
                    />
                    <tnt:NavigationListItem
                        text="Payslip"
                        icon="sap-icon://pdf-attachment"
                        key="Payslip"
                        visible="{= ${session>/role} === 'ADMIN' || ${session>/role} === 'HR' }"
                        select="onMenuSelect"
                    />
                    <!-- <tnt:NavigationListItem
                        text="Create Payroll"
                        icon="sap-icon://add"
                        key="PayrollCreate"
                        visible="{= ${session>/role} === 'ADMIN' || ${session>/role} === 'HR' }"
                        select="onPayrollCreate"
                    /> -->

                    <tnt:NavigationListItem
                        text="Logout"
                        icon="sap-icon://log"
                        select="onLogout"
                    />
                </tnt:NavigationList>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <!-- Main Content -->
        <tnt:mainContents>
            <App id="app" />
        </tnt:mainContents>
    </tnt:ToolPage>
</mvc:View>
