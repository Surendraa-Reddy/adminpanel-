<mvc:View
    controllerName="employee.controller.CreateDepartment"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">

    <Page
        title="Create Department"
        showNavButton="true"
        navButtonPress="onBack"
        class="sapUiContentPadding">

        <content>

            <Panel
                headerText="Department Information"
                expandable="false"
                class="sapUiResponsiveMargin sapUiContentPadding">

                <f:SimpleForm
                    editable="true"
                    layout="ResponsiveGridLayout"
                    columnsXL="2"
                    columnsL="2"
                    columnsM="2"
                    columnsS="1"
                    labelSpanXL="4"
                    labelSpanL="4"
                    labelSpanM="4"
                    labelSpanS="12"
                    emptySpanXL="1"
                    emptySpanL="1"
                    emptySpanM="0"
                    adjustLabelSpan="false"
                    singleContainerFullSize="false">

                    <Title text="General Information"/>

                    <!-- Department ID -->
                    <Label
                        text="Department ID"
                        required="true"/>

                    <Input
                        id="deptId"
                        width="100%"
                        maxLength="10"
                        placeholder="e.g. D001"
                        valueLiveUpdate="true"/>

                    <!-- Department Name -->
                    <Label
                        text="Department Name"
                        required="true"/>

                    <Input
                        id="deptName"
                        width="100%"
                        maxLength="40"
                        placeholder="Enter Department Name"
                        valueLiveUpdate="true"/>

                    <!-- Location -->
                    <Label text="Location"/>

                    <Input
                        id="location"
                        width="100%"
                        maxLength="40"
                        placeholder="e.g. Hyderabad"/>

                    <!-- Status -->
                    <Label text="Status"/>

                    <Select
                        id="status"
                        width="100%"
                        selectedKey="1">

                        <items>
                            <core:Item
                                key="1"
                                text="🟢 Active"/>

                            <core:Item
                                key="0"
                                text="🔴 Inactive"/>
                        </items>

                    </Select>

                </f:SimpleForm>

            </Panel>

        </content>

        <footer>

            <OverflowToolbar>

                <ToolbarSpacer/>

                <Button
                    text="Reset"
                    type="Transparent"
                    icon="sap-icon://reset"
                    press="onReset"/>

                <Button
                    text="Cancel"
                    type="Transparent"
                    icon="sap-icon://decline"
                    press="onBack"/>

                <Button
                    text="Create Department"
                    type="Emphasized"
                    icon="sap-icon://add"
                    press="onCreate"/>

            </OverflowToolbar>

        </footer>

    </Page>

</mvc:View>