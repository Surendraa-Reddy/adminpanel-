<mvc:View controllerName="admindemo.controller.demo1"
xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:sap.ui.layout="sap.ui.layout"
    xmlns:f="sap.ui.layout.form">
    <Page id="page1" title="{i18n>title}">
    <customHeader>
        <Bar>
            <contentLeft>
                <Title text="SAPUI5 Admin Dashboard"/>
            </contentLeft>
            <contentRight>
            <Button id="btn1" 
            icon="sap-icon://log" text="Logout"></Button>
      
            </contentRight>
        </Bar>
    </customHeader>
    <!-- <VBox id="box1"
        class="sapUiSmallMargin"
        renderType="Bare">
