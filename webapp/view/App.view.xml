<mvc:View
    controllerName="employee.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt">

    <tnt:ToolPage
        id="toolPage"
        sideExpanded="true">

        <!-- Header -->
        <tnt:header>

            <OverflowToolbar>

                <Button
                    icon="sap-icon://menu2"
                    type="Transparent"
                    press="onToggleMenu"/>

                <Title
                    text="Employee Management System"/>

                <ToolbarSpacer/>

                <Button
                    icon="sap-icon://bell"
                    type="Transparent"/>

                <Avatar
                    displayShape="Circle"
                    initials="A"/>

                <Text text="Administrator"/>

            </OverflowToolbar>

        </tnt:header>

        <!-- Sidebar -->
        <tnt:sideContent>

            <tnt:SideNavigation>

                <tnt:NavigationList>

                    <tnt:NavigationListItem
                        text="Dashboard"
                        icon="sap-icon://home"
                        select="onDashboard"/>

                    <tnt:NavigationListItem
                        text="Employees"
                        icon="sap-icon://employee"
                        select="onEmployee"/>

                    <tnt:NavigationListItem
                        text="Departments"
                        icon="sap-icon://building"
                        select="onDepartment"/>

                    <tnt:NavigationListItem
                        text="Roles"
                        icon="sap-icon://manager"
                        select="onRole"/>

                    <tnt:NavigationListItem
                        text="Attendance"
                        icon="sap-icon://calendar"
                        select="onAttendance"/>

                    <tnt:NavigationListItem
                        text="Leaves"
                        icon="sap-icon://leave-request"
                        select="onLeave"/>

                    <tnt:NavigationListItem
                        text="Reports"
                        icon="sap-icon://business-objects-experience"
                        select="onReports"/>

                </tnt:NavigationList>

            </tnt:SideNavigation>

        </tnt:sideContent>

        <!-- Main Content -->
        <tnt:mainContents>

            <App id="app"/>

        </tnt:mainContents>

    </tnt:ToolPage>

</mvc:View>